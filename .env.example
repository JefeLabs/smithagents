# smithagents environment — copy to .env at the repo root (git-ignored).
# The broker loads it via `node --env-file=../.env`; export it yourself for swarm.

# ── Required ────────────────────────────────────────────────────────────────

# The meeting brain (Claude Haiku via the Anthropic API).
# Create a key at https://platform.claude.com — subscription OAuth won't work here.
ANTHROPIC_API_KEY=

# Speech-to-text for push-to-talk and voice meetings.
# Free key (~$200 credit, no card) at https://console.deepgram.com
DEEPGRAM_API_KEY=

# LiveKit for voice meetings. Dev: run `livekit-server --dev` and use these values.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ── Voices (optional but recommended) ───────────────────────────────────────

# Per-agent voices, in the app and in voice meetings alike. Each agent's voice id
# lives in swarm/.smith/agents/*.json (squad members: broker/src/main.ts).
# Library voices need a paid ElevenLabs plan via API; on the free tier the broker
# falls back to premade stand-ins. Leave blank for OS speech synthesis instead.
ELEVENLABS_API_KEY=

# ── Channels (optional) ─────────────────────────────────────────────────────

# Discord bot token. Blank = the Discord adapter never starts (all-local by default).
DISCORD_TOKEN=

# Comma-separated channel ids the crew attends. Required if DISCORD_TOKEN is set.
DISCORD_CHANNELS=

# ── Optional (defaults shown) ───────────────────────────────────────────────

# Swarm HTTP API auth. Blank = loopback-only dev mode, no bearer token required.
# Set a token before binding swarm to anything beyond 127.0.0.1.
SMITH_API_TOKEN=

# Where the broker finds the swarm orchestrator.
#SWARM_URL=http://127.0.0.1:7777

# Broker text channel (the app's REST + WS endpoint).
#BROKER_TEXT_PORT=7790

# Broker persistence locations (relative to broker/).
#BROKER_STATE_FILE=.smith/roster-state.json
#BROKER_SESSIONS_DIR=.smith/sessions

# Bound on a single TTS request (ms), so a hung ElevenLabs call can't stall the turn queue.
#TTS_TIMEOUT_MS=30000
