# --- Node / front-end ---
node_modules/
dist/
.vite/
*.tsbuildinfo

# --- Rust / Tauri ---
# (Cargo.lock is intentionally committed for the control-plane app once it exists)
gen/
**/*.rs.bk

# --- Secrets / mTLS material (NEVER commit) ---
*.p12
*.pfx
*.pem
*.key
*.crt
*.csr
keystore.jks
truststore.jks
.env
.env.*
!.env.example

# --- ngrok ---
ngrok
ngrok.yml
.ngrok2/

# --- Generated audio assets ---
# Ephemeral MLX output is regenerated on demand; keep the folder, drop the contents.
# (If you later commit *pre-cached* persona reactions, add explicit `!audio-cache/<name>.wav` unignores.)
audio-cache/*
!audio-cache/.gitkeep

# --- Python (voice-engine) ---
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# --- macOS / IDE ---
.DS_Store
.idea/
*.iml

# --- Claude Code local (per-user) settings ---
.claude/settings.local.json

# Swarm runtime state — user crew/workspaces/squads live only on the machine, never in git.
swarm/.smith/

# Verification screenshots — local working artifacts, not source.
.screenshots/

# Superpowers plugin working state — per-machine, never source.
.superpowers/

# Playwright MCP browser artifacts — transient verification output.
.playwright-mcp/

# Claude Code project dir — local settings only in this repo.
.claude/

# Broker runtime state — personal arrangements and conversations, never source.
# (contents pattern, not the dir, so config below can be re-included — same as swarm/.smith)
broker/.smith/*
!broker/.smith/identity.json

# Synthesized audio cache — regenerable, per-machine.
broker/.smith/voice-cache/

# Crew memory is personal state, like sessions.
broker/.smith/memory.json
