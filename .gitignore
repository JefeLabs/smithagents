# --- JVM / Maven ---
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# --- Node / front-end ---
node_modules/
dist/
.vite/
*.tsbuildinfo

# --- Rust / Tauri ---
# (Cargo.lock is intentionally committed for the control-plane app once it exists)
gen/
**/*.rs.bk

# --- Secrets / mTLS material (NEVER commit) ---
*.p12
*.pfx
*.pem
*.key
*.crt
*.csr
keystore.jks
truststore.jks
.env
.env.*
!.env.example

# --- ngrok ---
ngrok
ngrok.yml
.ngrok2/

# --- Generated audio assets ---
# Ephemeral MLX output is regenerated on demand; keep the folder, drop the contents.
# (If you later commit *pre-cached* persona reactions, add explicit `!audio-cache/<name>.wav` unignores.)
audio-cache/*
!audio-cache/.gitkeep

# --- Python (voice-engine) ---
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# --- macOS / IDE ---
.DS_Store
.idea/
*.iml

# --- Claude Code local (per-user) settings ---
.claude/settings.local.json

# Swarm runtime state is ignored, but the seed composed-agents are committed.
swarm/.smith/
!swarm/.smith/agents/
!swarm/.smith/agents/*.json

# Verification screenshots — local working artifacts, not source.
.screenshots/

# Superpowers plugin working state — per-machine, never source.
.superpowers/

# Playwright MCP browser artifacts — transient verification output.
.playwright-mcp/

# Claude Code project dir — local settings only in this repo.
.claude/
