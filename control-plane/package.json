{
  "name": "smithagents-control-plane",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Unified Tauri 2.0 control plane (desktop + iOS) for the smithagents swarm.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
