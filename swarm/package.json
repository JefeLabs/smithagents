{
  "name": "@smithagents/swarm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fire-and-forget agent-swarm orchestrator (dispatcher, runtimes, server, CLI, squads, remote workers). Consumed by the e2e test framework.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "smith": "bin/smith.mjs",
    "smith-worker": "bin/smith-worker.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "serve": "npx tsx src/server.ts",
    "smith": "npx tsx src/cli.ts",
    "clean": "rm -rf dist",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.0",
    "fastify": "^5.10.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.1",
    "typescript": "~6.0.0"
  }
}
